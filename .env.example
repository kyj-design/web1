# Etsy API (필수)
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here
ETSY_CALLBACK_URL=http://localhost:3000/auth/callback
# Etsy Shop ID: Etsy 판매자 계정의 Shop ID (Phase 5 OAuth 완성 전까지 직접 입력)
# 확인: https://www.etsy.com/shop/your-shop-name → URL의 숫자 ID
ETSY_SHOP_ID=

# AI Provider (로컬 LLM 사용, 무료)
LLM_PROVIDER=ollama  # ollama 또는 openai
OLLAMA_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API (선택, 유료)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4

# Database
DATABASE_URL=sqlite:///./canva_etsy.db
# Production용 PostgreSQL 예시:
# DATABASE_URL=postgresql://user:password@localhost/canva_etsy

# eRank API (선택, 유료)
# ERANK_API_KEY=your_erank_key_here

# Redis (Celery용, 나중에)
# REDIS_URL=redis://localhost:6379/0

# CORS (프론트엔드 URL)
FRONTEND_URL=http://localhost:3000

# 파일 저장 경로
UPLOAD_DIR=./backend/uploads
PDF_DIR=./backend/static/pdfs
IMAGE_DIR=./backend/static/images

# 로그 레벨
LOG_LEVEL=INFO
