# Vercel 프로덕션 환경변수 (Vercel 대시보드 > Settings > Environment Variables에 등록)
# 파일명: .env.production.example (실제 사용 시 .env.production으로 복사하거나 Vercel에 직접 입력)

# 백엔드 API URL (Railway/Render/Fly.io 등 배포 후 URL 입력)
# vite.config.js의 proxy는 개발 전용이므로, 프로덕션에서는 이 변수로 대체됨
VITE_API_BASE_URL=https://your-backend-domain.com
